import java.util.Scanner;

public class IT22195616Lab5Q3 {

    public static void main(String[] args) {
	
        Scanner in = new Scanner(System.in);
        
        
         double ROOM_CHARGE_PER_DAY = 48000.0;
        
        System.out.print("Enter the start date (1-31): ");
        int startDate = in.nextInt();
        
        System.out.print("Enter the end date (1-31): ");
        int endDate = in.nextInt();
            
        
        if (startDate < 1 || startDate > 31 || endDate < 1 || endDate > 31) {
            System.out.println("Error : Dates must be in between 1 & 31");
			return;
        } 
        
        else if (startDate > endDate) {
            System.out.println("Error : Start Date must be less than end date");
			return;
        } 
        else {
            
            int dateStayed = endDate - startDate;
            double totalAmount = 0.0;
            
            
            if (dateStayed < 3) {
                totalAmount = dateStayed * ROOM_CHARGE_PER_DAY;
				
            } else if (dateStayed >= 3 && dateStayed <= 4) {
                totalAmount = (dateStayed * ROOM_CHARGE_PER_DAY) * (1 - 0.10); // 10% discount
				
            } else {
                totalAmount = (dateStayed * ROOM_CHARGE_PER_DAY) * (1 - 0.20); // 20% discount
            }
            
            
            System.out.println("Room Charge Per Day: Rs. " + ROOM_CHARGE_PER_DAY + "/=");
            System.out.println("Number of Days Reserved: " + dateStayed);
            System.out.println("Total Amount to be Paid: " + totalAmount);
        }
        
    }
}